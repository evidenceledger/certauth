# Use a specific slim version for security and stability
FROM python:3.12-slim

# Prevent prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system libraries and DejaVu fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libffi-dev \
    shared-mime-info \
    fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

# Install WeasyPrint
RUN pip install --no-cache-dir weasyprint

# Create a non-root user for security
RUN useradd -m weasyuser
USER weasyuser

# Set the entrypoint to weasyprint
ENTRYPOINT ["weasyprint"]