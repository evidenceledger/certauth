# Global options
{
    # Local CA for localhost development
    local_certs
}

# Caddy reverse proxy configuration for local development

# Certauth service - https://certauth.localhost
certauth.localhost {
    # Enable compression
    encode zstd gzip

    # Remove Server header for security
    header -Server

    # Reverse proxy to certauth service (port 8010 on the certauth container)
    reverse_proxy certauth:8010 {
        # Health checks
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    # Logging
    log {
        output file /var/log/caddy/certauth.log
        format json
    }
}

# Certsec service - https://certsec.localhost (with mTLS client authentication)
certsec.localhost {
    # Enable compression
    encode zstd gzip

    # Remove Server header for security
    header -Server

    # Enable client certificate authentication for local development
    # Request client certificates (mode: request allows both with and without cert)
    tls {
        client_auth {
            mode request
        }
    }

    # Reverse proxy to certsec service (port 8011 on the certauth container)
    reverse_proxy certauth:8011 {
        # Forward the client certificate to the backend in the format expected by certsec
        # certsec expects the header "tls-client-certificate" with base64-encoded DER format
        header_up tls-client-certificate {http.request.tls.client.certificate_der_base64}
        
        # Health checks
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    # Logging
    log {
        output file /var/log/caddy/certsec.log
        format json
    }
}

# Onboard service - https://onboard.localhost
onboard.localhost {
    # Enable compression
    encode zstd gzip

    # Remove Server header for security
    header -Server

    # Reverse proxy to onboard service (port 8012 on the certauth container)
    reverse_proxy certauth:8012

    # Logging
    log {
        output file /var/log/caddy/onboard.log
        format json
    }
}
